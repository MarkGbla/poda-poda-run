{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poda-poda-run-local",
  "main": "./server/worker.mjs",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "PUBLIC_ORIGIN": "http://localhost:8787", "ACCOUNTS_ENABLED": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "poda-poda-run-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "server/db/migrations" }]
}
