{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poda-poda-run",
  "main": "./server/worker.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podapodarun",
      "database_id": "08c30206-6529-46f8-8876-8ac2fc9a46a1",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://podapodarun.com",
    "ACCOUNTS_ENABLED": "true",
    "GOOGLE_CLIENT_ID": "288666325440-2vctm4qamkbp3vu9eg9cijfknntij2o1.apps.googleusercontent.com"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_SECRET"]
  }
}
