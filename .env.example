# Copy to .env for local development. Never commit real credentials.
# Register http://localhost:8787/api/auth/google/callback with Google.
# D1 is a Wrangler binding named DB, not an .env key.
# Local DB: wrangler.local.jsonc; production DB: wrangler.jsonc (podapodarun).
# Production Google values must be added as Cloudflare Worker secrets.
PUBLIC_ORIGIN="http://localhost:8787"
ACCOUNTS_ENABLED="true"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=""
